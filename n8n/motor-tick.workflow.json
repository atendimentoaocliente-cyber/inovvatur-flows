{
  "name": "[Motor] Tick do disparador (1 min)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }
      },
      "id": "cron-1min",
      "name": "A cada 1 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-940, 320],
      "notes": "O cron da Vercel NÃO serve: o plano Hobby só aceita uma vez por dia, e uma expressão mais frequente faz o deploy inteiro falhar."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "appUrl", "value": "https://inovvatur-disparador.vercel.app", "type": "string" },
            { "id": "c2", "name": "cronSecret", "value": "COLE_O_VALOR_DE_CRON_SECRET", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-720, 320],
      "notes": "cronSecret = a variável CRON_SECRET do projeto na Vercel."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.appUrl }}/api/dispatch/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-cron-secret", "value": "={{ $json.cronSecret }}" }]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "tick",
      "name": "Tick do motor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-500, 320],
      "notes": "Com o motor desligado, responde 200 {motor: desligado} e não faz nada. Idempotente: chamar duas vezes seguidas não duplica envio."
    }
  ],
  "connections": {
    "A cada 1 min": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Tick do motor", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
