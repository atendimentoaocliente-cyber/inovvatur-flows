{
  "name": "[Recorrentes] Refill diário",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "cron-diario",
      "name": "Todo dia 03:00 (BRT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-940, 320],
      "notes": "06:00 UTC = 03:00 em São Paulo. Horário morto, longe dos disparos."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "appUrl",
              "value": "https://COLE_A_URL_DA_PLATAFORMA",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "cronSecret",
              "value": "COLE_O_MESMO_VALOR_DE_CRON_SECRET",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-720, 320],
      "notes": "appUrl = URL pública do disparador (sem barra no fim). cronSecret = env CRON_SECRET da plataforma."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.appUrl }}/api/recorrencias/refill",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{ $json.cronSecret }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "refill",
      "name": "Refill recorrências",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-500, 320],
      "notes": "Idempotente: cria só as ocorrências que faltam no horizonte de 6 semanas. Rodar duas vezes não duplica."
    }
  ],
  "connections": {
    "Todo dia 03:00 (BRT)": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Refill recorrências", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
