{
  "name": "[Campanhas Avulsas] Supabase -> SUB",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 3
            }
          ]
        }
      },
      "id": "trigger",
      "name": "A cada 3 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1120,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "supabaseUrl",
              "value": "https://vbyxzpxwtefjgyeawhsw.supabase.co",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "supabaseKey",
              "value": "COLE_SUA_SERVICE_ROLE_KEY",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "subWorkflowId",
              "value": "kEPapZTa9tcUSKgH",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -920,
        300
      ],
      "notes": "Cole aqui sua service_role key do Supabase. supabaseUrl e subWorkflowId ja estao preenchidos."
    },
    {
      "parameters": {
        "url": "={{ $json.supabaseUrl }}/rest/v1/campaigns?select=*,audiences(*)&status=eq.agendada&enviar_em=lte.{{ $now.toUTC().toISO() }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "fetch-due",
      "name": "Buscar campanhas due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -700,
        300
      ],
      "notes": "Le campanhas agendadas cujo horario ja chegou (status=agendada e enviar_em<=agora)."
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/groups?select=group_id&ativo=eq.true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-groups",
      "name": "Buscar grupos ativos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const campaigns = $('Buscar campanhas due').all().map(i => i.json).filter(c => c && c.id);\nconst allGroupIds = $('Buscar grupos ativos').all().map(i => i.json.group_id).filter(Boolean);\nconst cfg = $('Config').first().json;\n\nreturn campaigns.map(c => {\n  const aud = c.audiences; // linha embutida do publico, ou null\n  const group_ids = (aud && aud.tipo === 'manual' && Array.isArray(aud.group_ids) && aud.group_ids.length)\n    ? aud.group_ids\n    : allGroupIds; // publico \"todos\" (ou sem publico) => todos os grupos ativos\n  return { json: {\n    id: c.id,\n    texto: c.mensagem,\n    tipo: c.tipo,\n    midia_url: c.midia_url || '',\n    mencionar_todos: c.mencionar_todos ? 'sim' : 'nao',\n    group_ids,\n    supabaseUrl: cfg.supabaseUrl,\n    supabaseKey: cfg.supabaseKey,\n  } };\n});"
      },
      "id": "prepare",
      "name": "Preparar lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "loop",
      "name": "Loop Campanhas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {},
      "id": "fim",
      "name": "Fim",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        200,
        160
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $json.id }}&status=eq.agendada",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"enviando\", \"resultado\": { \"total\": {{ $json.group_ids.length }}, \"enviados\": 0, \"falhas\": 0 } }",
        "options": {}
      },
      "id": "mark-sending",
      "name": "Marcar enviando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        380
      ],
      "notes": "O filtro &status=eq.agendada evita reprocessar se outra execucao ja pegou a campanha."
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "kEPapZTa9tcUSKgH",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "send",
      "name": "Enviar para Grupos",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        420,
        380
      ],
      "onError": "continueErrorOutput",
      "notes": "Chama o [SUB] Enviar para Grupos passando texto/tipo/midia_url/mencionar_todos/group_ids."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Loop Campanhas').first().json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $('Loop Campanhas').first().json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"enviada\", \"enviado_em\": \"{{ $now.toUTC().toISO() }}\", \"resultado\": { \"total\": {{ $('Loop Campanhas').first().json.group_ids.length }}, \"enviados\": {{ $('Loop Campanhas').first().json.group_ids.length }}, \"falhas\": 0 } }",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Marcar enviada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Loop Campanhas').first().json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $('Loop Campanhas').first().json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"erro\", \"resultado\": { \"total\": {{ $('Loop Campanhas').first().json.group_ids.length }}, \"enviados\": 0, \"falhas\": {{ $('Loop Campanhas').first().json.group_ids.length }}, \"erro\": \"falha ao chamar o SUB de envio\" } }",
        "options": {}
      },
      "id": "mark-error",
      "name": "Marcar erro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        480
      ]
    }
  ],
