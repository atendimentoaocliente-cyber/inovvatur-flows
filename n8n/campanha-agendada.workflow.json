{
  "name": "[Campanha Agendada] Webhook -> Wait -> SUB",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "campanha-agendada",
        "options": {}
      },
      "id": "webhook",
      "name": "Recebe agendamento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        300
      ],
      "webhookId": "campanha-agendada"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "supabaseUrl",
              "value": "https://vbyxzpxwtefjgyeawhsw.supabase.co",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "supabaseKey",
              "value": "COLE_SUA_SERVICE_ROLE_KEY",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "subWorkflowId",
              "value": "kEPapZTa9tcUSKgH",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1000,
        300
      ],
      "notes": "Cole sua service_role key em supabaseKey."
    },
    {
      "parameters": {
        "jsCode": "const wh = $('Recebe agendamento').first().json;\nlet b = (wh && wh.body != null) ? wh.body : wh;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nconst id = b && (b.id || (b.record && b.record.id));\nif (!id) throw new Error('Payload sem id. Recebido do webhook: ' + JSON.stringify(wh).slice(0, 400));\nconst cfg = $('Config').first().json;\nreturn [{ json: { id, supabaseUrl: cfg.supabaseUrl, supabaseKey: cfg.supabaseKey } }];"
      },
      "id": "extract",
      "name": "Extrair id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $json.id }}&select=*,audiences(*)",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "read1",
      "name": "Ler campanha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "x1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "agendada",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if1",
      "name": "É agendada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {},
      "id": "ign",
      "name": "Ignorado (não agendada)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -200,
        480
      ]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $json.enviar_em }}"
      },
      "id": "wait",
      "name": "Esperar horário exato",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -200,
        240
      ],
      "webhookId": "wait-campanha-agendada"
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $('Extrair id').first().json.id }}&select=*,audiences(*)",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "read2",
      "name": "Reler campanha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        240
      ],
      "notes": "Rele o status logo antes de enviar — se voce cancelou/editou nesse meio tempo, nao envia."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "x2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "agendada",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if2",
      "name": "Ainda agendada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        200,
        240
      ],
      "notes": "Envia se ainda estiver agendada (se voce cancelou nesse meio tempo, o status muda e ele nao envia)."
    },
    {
      "parameters": {},
      "id": "canc",
      "name": "Cancelada/editada",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        400,
        420
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/groups?select=group_id&ativo=eq.true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "groups",
      "name": "Buscar grupos ativos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const c = $('Reler campanha').first().json;\nconst allGroupIds = $('Buscar grupos ativos').all().map(i => i.json.group_id).filter(Boolean);\nconst aud = c.audiences;\nconst group_ids = (Array.isArray(c.group_ids) && c.group_ids.length)\n  ? c.group_ids\n  : (aud && aud.tipo === 'manual' && Array.isArray(aud.group_ids) && aud.group_ids.length)\n  ? aud.group_ids\n  : allGroupIds;\nconst cfg = $('Config').first().json;\nreturn [{ json: {\n  id: c.id,\n  texto: c.mensagem,\n  tipo: c.tipo,\n  midia_url: c.midia_url || '',\n  mencionar_todos: c.mencionar_todos ? 'sim' : 'nao',\n  group_ids,\n  supabaseUrl: cfg.supabaseUrl,\n  supabaseKey: cfg.supabaseKey,\n} }];"
      },
      "id": "prep",
      "name": "Preparar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $json.id }}&status=eq.agendada",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"enviando\", \"resultado\": { \"total\": {{ $json.group_ids.length }}, \"enviados\": 0, \"falhas\": 0 } }",
        "options": {}
      },
      "id": "mark-sending",
      "name": "Marcar enviando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "texto",
              "type": "string",
              "value": "={{ $('Preparar envio').first().json.texto }}"
            },
            {
              "id": "e2",
              "name": "tipo",
              "type": "string",
              "value": "={{ $('Preparar envio').first().json.tipo }}"
            },
            {
              "id": "e3",
              "name": "midia_url",
              "type": "string",
              "value": "={{ $('Preparar envio').first().json.midia_url }}"
            },
            {
              "id": "e4",
              "name": "mencionar_todos",
              "type": "string",
              "value": "={{ $('Preparar envio').first().json.mencionar_todos }}"
            },
            {
              "id": "e5",
              "name": "group_ids",
              "type": "array",
              "value": "={{ $('Preparar envio').first().json.group_ids }}"
            }
          ]
        },
        "options": {}
      },
      "id": "prep-input",
      "name": "Preparar entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "kEPapZTa9tcUSKgH",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "send",
      "name": "Enviar para Grupos",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Preparar envio').first().json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $('Preparar envio').first().json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"enviada\", \"enviado_em\": \"{{ $now.toUTC().toISO() }}\", \"resultado\": { \"total\": {{ $('Preparar envio').first().json.group_ids.length }}, \"enviados\": {{ $('Preparar envio').first().json.group_ids.length }}, \"falhas\": 0 } }",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Marcar enviada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        120
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Preparar envio').first().json.supabaseUrl }}/rest/v1/campaigns?id=eq.{{ $('Preparar envio').first().json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"erro\", \"resultado\": { \"total\": {{ $('Preparar envio').first().json.group_ids.length }}, \"enviados\": 0, \"falhas\": {{ $('Preparar envio').first().json.group_ids.length }}, \"erro\": \"falha ao chamar o SUB de envio\" } }",
        "options": {}
      },
      "id": "mark-error",
      "name": "Marcar erro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        300
      ]
    }
  ],
