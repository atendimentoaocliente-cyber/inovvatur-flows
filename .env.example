NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_MEDIA_BUCKET=campanhas-midia
# URL do webhook do workflow n8n "[Campanha Agendada]" (opcional — habilita disparo no horário exato)
N8N_WEBHOOK_URL=

# Segredo do refill das campanhas recorrentes (header x-cron-secret no POST /api/recorrencias/refill).
# Se vazio, o endpoint fica aberto — defina em produção.
CRON_SECRET=

# Evolution API — motor de envio novo (ainda desligado; quem envia hoje é o n8n + Z-API).
# A URL é a base do seu Evolution, sem barra no fim. A chave é a AUTHENTICATION_API_KEY
# (a global do servidor), não a chave de uma instância.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Trava do motor de envio novo. Vazio/ausente = DESLIGADO (quem envia é o n8n + Z-API).
# Só coloque 1 quando for virar a chave: ligado, ele assume as campanhas agendadas e o
# n8n deixa de vê-las. Para voltar atrás, remova a variável — a fila fica intacta.
MOTOR_WHATSAPP=

# URL pública do app. Vai embutida no webhook registrado na Evolution — sem ela, na
# Vercel o endereço muda a cada deploy e os eventos de entrega/leitura param de chegar.
APP_URL=

# Segredo do webhook da Evolution. Ela não permite cabeçalho no webhook, então o
# segredo viaja na própria URL (?s=...). Gere com: openssl rand -hex 32
WEBHOOK_SECRET=
